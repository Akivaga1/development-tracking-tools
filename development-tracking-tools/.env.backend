# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-reflect-evolve-dtt-change-me-in-production-replace-this-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=reflect_evolve_dtt
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@reflect-evolve.com

# ─── Frontend URL (for password-reset links) ──────────────────────────────────
FRONTEND_URL=http://localhost:5173
